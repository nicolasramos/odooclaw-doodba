# Ignore all src directories except private and files with a dot
/odoo/auto
/odoo/custom/src/*/
!/odoo/custom/src/private/

# Ignore docker-compose.yml and overrides by default, to allow easy defaults per clone
/docker-compose.yml
/docker-compose.override.yml

# Compiled formats, cache, temporary files, git garbage
**.~
**.mo
**.py[co]
**.egg-info
**.orig

# User-specific or editor-specific development files and settings
.vscode/*
!/.vscode/*.jinja
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/tasks.json
/odoo/custom/src/private/.vscode/*
/.venv
/doodba.*.code-workspace
/src
.idea/*

# Project-specific docker configurations
/.docker/

# Local credentials and secrets
**/.env
**/.env.*
**/*credentials*.json
**/*token*
!/odooclaw/pkg/auth/token.go
# The OdooClaw Discuss bridge ships a reply-token MODEL (not a secret). The
# broad `**/*token*` rule above would silently drop it, leaving models/__init__.py
# importing a missing module and Odoo failing with ImportError at registry load.
!/odoo/custom/src/private/mail_bot_odooclaw/models/mail_odooclaw_reply_token.py
!/odoo/custom/src/private/mail_bot_odooclaw/tests/test_mail_odooclaw_reply_token.py
**/*.pem
**/*.key

# OdooClaw local runtime config
/odooclaw/config/config.json

# OdooClaw local build artifacts
/odooclaw/build/
