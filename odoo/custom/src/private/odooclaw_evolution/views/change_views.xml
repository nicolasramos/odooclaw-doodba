<odoo>
    <record id="view_odooclaw_change_list" model="ir.ui.view">
        <field name="name">odooclaw.change.list</field>
        <field name="model">odooclaw.change</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'failed'" decoration-muted="status == 'rolled_back'">
                <field name="reference"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="level"/>
                <field name="status"/>
                <field name="target_model"/>
                <field name="applied_at"/>
            </list>
        </field>
    </record>

    <record id="view_odooclaw_change_form" model="ir.ui.view">
        <field name="name">odooclaw.change.form</field>
        <field name="model">odooclaw.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary" invisible="status != 'validated'"/>
                    <button name="action_rollback" string="Rollback" type="object" invisible="status != 'applied'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,validated,applied,rolled_back"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="level"/>
                            <field name="target_model"/>
                            <field name="requested_by"/>
                            <field name="approved_by"/>
                        </group>
                        <group>
                            <field name="artifact_hash"/>
                            <field name="applied_at"/>
                            <field name="rolled_back_at"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_text"/>
                        </page>
                        <page string="Payload">
                            <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Snapshot">
                            <field name="snapshot" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odooclaw_change_search" model="ir.ui.view">
        <field name="name">odooclaw.change.search</field>
        <field name="model">odooclaw.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="target_model"/>
                <filter name="draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="validated" string="Validated" domain="[('status', '=', 'validated')]"/>
                <filter name="applied" string="Applied" domain="[('status', '=', 'applied')]"/>
                <filter name="rolled_back" string="Rolled back" domain="[('status', '=', 'rolled_back')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_odooclaw_change" model="ir.actions.act_window">
        <field name="name">Changes</field>
        <field name="res_model">odooclaw.change</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
